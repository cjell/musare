# Copy this to .env and fill in real values. .env is gitignored; this file is not.
#   cp .env.example .env

# ---- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security - never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI
# This is what psycopg uses for the pipelines.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Ticketmaster ---------------------------------------------------------
# developer.ticketmaster.com -> My Apps -> Consumer Key
TICKETMASTER_API_KEY=

# ---- Spotify --------------------------------------------------------------
# developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the Redirect URI registered in the dashboard, character for character.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/spotify

# ---- Model provider -------------------------------------------------------
# Spec generation runs behind one interface, so either provider works and the
# eval harness can compare them. OpenAI is primary (strict Structured Outputs
# constrains generation to the Pydantic schema); Anthropic is optional.
# platform.openai.com -> API keys
OPENAI_API_KEY=
# console.anthropic.com -> API Keys (optional, for the provider comparison)
ANTHROPIC_API_KEY=

# ---- Langfuse (tracing) - not needed until the eval harness ---------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
